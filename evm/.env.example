# Deployment environment for onchain/evm.
#
# Copy to `.env` and fill in. `.env` is gitignored (see the repo root .gitignore); `.env.example`
# is the committed template and must never contain a real key.
#
#   cp .env.example .env
#
# Foundry loads `.env` automatically when a forge command runs from this directory.

# ---------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------

# JSON-RPC endpoints. Referenced by [rpc_endpoints] in foundry.toml, which is what makes
# `--rpc-url sepolia` (etc.) resolve. Fill in the one you intend to deploy to.
#
# Arbitrum has public endpoints that work fine for a dry run:
#   ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
#   ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Use a provider endpoint (Alchemy, Infura) for a real broadcast — public ones rate-limit.
SEPOLIA_RPC_URL=
ARBITRUM_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=

# ---------------------------------------------------------------------------------------------
# Signing — pick ONE
# ---------------------------------------------------------------------------------------------
#
# Preferred: do NOT set PRIVATE_KEY. Import the key into Foundry's encrypted keystore once
#
#   cast wallet import sepolia-deployer --interactive
#
# and deploy with `npm run deploy:sepolia` (which passes --account sepolia-deployer). The key is
# then encrypted at rest and never present in a file this repo can read. `--ledger` works too.
#
# Fallback, for CI or a throwaway testnet key only: set PRIVATE_KEY and the script will use it.
# It must be 0x-prefixed. Anything here is plaintext on disk — do not use a key that holds
# anything you care about.
PRIVATE_KEY=

# ---------------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------------

# Etherscan API key, only for `--verify`. Deployment works without it; verification can be run
# afterwards with `npm run verify:sepolia` / `verify:arbitrum` / `verify:arbitrum-sepolia`.
#
# One key covers every chain here: Etherscan's V2 API is multichain and Foundry routes by chain id,
# so no separate Arbiscan key is needed.
ETHERSCAN_API_KEY=

# Salt for the deterministic CREATE2 address. Changing it changes the deployed address, so leave
# it alone unless you intend a separate, parallel deployment (a staging instance, say).
# Default: nihilium-recovery-module-v1
DEPLOY_SALT=

# Address of an already-deployed module, used by the `verify:*` scripts. Filled in from
# deployments/<chainid>.json after a successful deploy. CREATE2 means it is the *same* address on
# every chain, so one value serves all of them.
RECOVERY_MODULE_ADDRESS=

# Escape hatch for the script's chain allowlist. The allowlist holds only chains where a mistake
# is free: Ethereum Sepolia, Arbitrum Sepolia, and Anvil.
#
# Any MAINNET — Arbitrum One (42161) included — needs this set to true, deliberately. That is the
# point of the guard: reaching a mainnet with a funded key should take a second, explicit act.
ALLOW_ANY_CHAIN=
